# Copia este archivo como .env y completa con tus propios valores.
# Nunca subas el .env real al repositorio.

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=bspbank
# Conexiones simultáneas del pool.
DB_POOL_SIZE=10

# --- Servidor ---
PORT=3000
# Ponlo en "production" al desplegar: exige JWT_SECRET y restringe CORS.
NODE_ENV=development

# URL pública del frontend. Se usa para los enlaces de recuperación de
# contraseña y como origen esperado por WebAuthn.
APP_URL=http://localhost:4200

# Orígenes permitidos por CORS en producción, separados por comas.
# Si se omite, se usa APP_URL.
CORS_ORIGINS=http://localhost:4200

# --- Sesiones ---
# Obligatorio en producción: el servidor no arranca sin él.
# Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=1h

# --- WebAuthn (inicio de sesión biométrico) ---
# RP_ID es el dominio sin protocolo ni puerto (ej. bspbank.com).
# Si no se definen, se derivan de APP_URL.
RP_NAME=BSP Bank
# RP_ID=bspbank.com
# WEBAUTHN_ORIGIN=https://bspbank.com

# --- Correo (recuperación de contraseña y comprobantes) ---
# Si se dejan vacíos, la app funciona pero no envía correos.
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
